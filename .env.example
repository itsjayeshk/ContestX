# ---------- Core ----------
# PostgreSQL connection string (UTC is used for all stored timestamps)
DATABASE_URL="postgresql://contestx:contestx@localhost:5432/contestx"
# Optional: shadow database for `prisma migrate dev` and drift checks
SHADOW_DATABASE_URL=""
# Optional: separate database for integration tests (it is truncated between tests!)
TEST_DATABASE_URL="postgresql://contestx:contestx@localhost:5432/contestx_test"
# Public base URL of the web app, used in emails, calendar feeds and push links
APP_URL="http://localhost:3000"
# Random 32+ char string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Shared secret for POST /api/cron/tick (only needed if you drive the worker from an external cron)
CRON_SECRET=""
# Comma-separated emails that get the admin role on register / seed
ADMIN_EMAILS=""

# ---------- Worker ----------
SYNC_INTERVAL_MINUTES=20
DISPATCH_INTERVAL_SECONDS=30
# How many days of finished contests to keep for the calendar and analytics
PAST_CONTEST_RETENTION_DAYS=180
# Optional contact added to the User-Agent sent to platforms
PROVIDER_CONTACT="you@example.com"

# ---------- Email (Resend) ----------
# Leave empty to disable the email channel; the UI will say it is not configured.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, e.g. "ContestX <reminders@yourdomain.com>"
EMAIL_FROM=""

# ---------- Web Push (VAPID) ----------
# Generate with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ---------- Logging ----------
LOG_LEVEL="info"
